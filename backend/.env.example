# =============================================================================
# CampusX Backend Environment Variables Template
# Copy this file to `backend/.env` (or root `.env`) and provide your values.
# =============================================================================

# Server Port
PORT=3000

# Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS Origins (comma-separated, or * for all during local development)
CORS_ORIGIN=*

# PostgreSQL / Supabase Database Connection String
# -----------------------------------------------------------------------------
# Leave empty to run with the built-in resilient development storage.
# When ready for persistent PostgreSQL / Supabase storage, paste your URI here:
#
# Option A: Supabase Session Pooler (RECOMMENDED on Windows - IPv4 compatible)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Option B: Supabase Direct Connection (Requires IPv6 network support)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=

# Supabase Project Credentials (Optional - for direct frontend or edge functions)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=campusx_development_secret_key_change_in_production
